{
  "servers": {
    "paper-DIC4": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "${workspaceFolder}"
      ]
    },
    "overleaf": {
      "type": "stdio",
      "command": "npx.cmd",
      "args": [
        "-y",
        "overleaf-web-mcp@1.3.0",
        "serve"
      ]
    }
  }
}
